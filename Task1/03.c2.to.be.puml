@startuml GoFuture_Task1_ToBe_C2
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundcorner 14
skinparam linetype ortho


Person(users, "Пользователи", "Пассажиры, водители, корпоративные менеджеры и бухгалтеры")

System_Ext(external_integrations, "Внешние интеграции", "Яндекс Карты, Яндекс Пэй, API Банка, push-провайдеры")
System_Ext(datalens, "DataLens", "BI-дашборды")

System_Boundary(gofuture, "GoFuture Platform To-Be") {

    Container(clients, "Клиентские приложения", "Mobile / Web", "Пассажирское и водительское приложения, корпоративный портал, админ-панель", $tags="entry")

    Container(api_gateway, "API Gateway / BFF", "Envoy/Nginx + REST adapters", "Сохраняет старые REST-контракты и постепенно переводит маршруты на сервисы", $tags="entry")

    Container(legacy_monolith, "Legacy Monolith", "Django", "Неперенесённые сценарии до завершения миграции", $tags="legacy")

    Container(compat_layer, "Compatibility / ACL Layer", "Python adapters", "Адаптирует старые DTO и защищает новые сервисы от legacy-модели", $tags="legacy")

    Container_Boundary(core_services, "Core domain services") {
        Container(booking_service, "Booking Service", "Python service", "Заказы, поездки, статусы", $tags="domain")
        Container(driver_service, "Driver Service", "Python service", "Водители, документы, смены", $tags="domain")
        Container(geography_service, "Geography Service", "Python service", "ETA, маршруты, зоны", $tags="domain")
        Container(pricing_service, "Pricing Service", "Python service", "Тарифы и динамическая цена", $tags="domain")
        Container(fraud_service, "Fraud Service", "Python service", "Скоринг поездок и платежей", $tags="domain")
        Container(payments_service, "Payments Service", "Python service", "Оплаты, счета, выплаты, ledger", $tags="domain")
    }

    ContainerQueue(event_broker, "Integration Broker", "RabbitMQ + Outbox/CDC", "Доменные события, команды и синхронизация на время миграции", $tags="async")

    Container_Boundary(async_services, "Async and data services") {
        Container(notification_service, "Notification Service", "Python workers/API", "Шаблоны, предпочтения и доставка уведомлений", $tags="async")
        Container(analytics_service, "Analytics Service", "Flink/Spark jobs + API", "События, агрегаты и BI-витрины", $tags="async")
    }

    ContainerDb(service_datastores, "Private service datastores", "PostgreSQL / ClickHouse / Elasticsearch / Redis", "Каждый доменный сервис владеет своей БД, схемой или индексом", $tags="data")

    Container(observability, "Observability Stack", "Prometheus / Grafana / Loki / Alertmanager", "Метрики, логи, трейсы, SLO и алерты", $tags="infra")
}

' Существующие связи — без изменения смысла и подписей
Rel_R(users, clients, "Используют")
Rel_R(clients, api_gateway, "Существующий REST API", "HTTPS")

Rel_D(api_gateway, legacy_monolith, "fallback", "HTTP")
Rel_R(api_gateway, core_services, "new routes", "REST")

Rel_R(legacy_monolith, compat_layer, "ACL")
Rel_U(compat_layer, core_services, "DTO", "REST")

Rel_R(core_services, event_broker, "events")
Rel_R(event_broker, async_services, "async")

Rel_R(async_services, service_datastores, "private data")

Rel_U(core_services, external_integrations, "REST")
Rel_U(async_services, external_integrations, "push")
Rel_D(async_services, datalens, "BI")

' Только компоновка — не дополнительные архитектурные связи
Lay_R(users, clients)
Lay_R(clients, api_gateway)
Lay_R(api_gateway, core_services)

Lay_D(api_gateway, legacy_monolith)
Lay_R(legacy_monolith, compat_layer)

' Компактная сетка доменных сервисов: два столбца
Lay_R(booking_service, driver_service)
Lay_R(geography_service, pricing_service)
Lay_R(fraud_service, payments_service)

Lay_D(booking_service, geography_service)
Lay_D(geography_service, fraud_service)
Lay_D(driver_service, pricing_service)
Lay_D(pricing_service, payments_service)

Lay_R(core_services, event_broker)
Lay_R(event_broker, async_services)
Lay_D(notification_service, analytics_service)
Lay_R(async_services, service_datastores)

Lay_U(core_services, external_integrations)
Lay_D(async_services, datalens)
Lay_D(service_datastores, observability)

SHOW_LEGEND()
@enduml
