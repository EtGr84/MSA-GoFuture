@startuml GoFuture_Task2_Event_Platform
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65



    ContainerDb(service_dbs, "Service DBs with outbox", "PostgreSQL", "Доменные таблицы и outbox-записи")
    Container(outbox_relay, "Outbox Relay / CDC", "Debezium + Kafka Connect", "Публикует outbox-записи в Kafka")

    Container_Boundary(kafka_platform, "Kafka event backbone") {
        ContainerQueue(kafka, "Regional Kafka clusters", "Apache Kafka / Yandex Managed Kafka", "Топики по доменам, partition key: region_id + aggregate_id")
        Container(schema_registry, "Schema Registry", "Avro/Protobuf schemas", "Версионирование и compatibility checks")
        Container(retry_dlq, "Retry and DLQ topics", "Kafka topics", "Backoff, poison messages, ручной разбор")
    }

    Container_Boundary(event_consumers, "Event consumers and processors") {
        Container(saga, "Booking Saga Orchestrator", "Booking Service module", "Координирует цену, fraud, назначение водителя и платёж")
        Container(flink, "Flink / Kafka Streams", "Stream processing", "Demand/supply, hot zones, fraud features")
        Container(notification, "Notification Service", "Python workers/API", "Команды уведомлений")
        Container(analytics, "Analytics Service", "Flink/Spark + ClickHouse", "Сырые события, агрегаты и BI-витрины")
        ContainerDb(projections, "Realtime projections", "Redis / Elasticsearch / ClickHouse", "Материализованные представления и аналитические витрины")
    }

        Container_Boundary(domain_services, "Domain services") {
        Container(booking, "Booking Service", "Python service", "Saga поездки, BookingCreated")
        Container(driver, "Driver Service", "Python service", "DriverLocationUpdated")
        Container(geography, "Geography Service", "Python service", "RouteCalculated, HotZoneDetected")
        Container(pricing, "Pricing Service", "Python service", "PriceCalculated")
        Container(fraud, "Fraud Service", "Python service", "FraudApproved / FraudRejected")
        Container(payments, "Payments Service", "Python service", "PaymentAuthorized, PayoutCreated")
    }

    Container_Boundary(monitoring, "Monitoring tools") {
        Container(exporters, "Kafka Observability Exporters", "JMX Exporter / Kafka Exporter / Burrow", "Broker metrics и consumer lag")
        Container(prometheus, "Prometheus", "Metrics storage", "Метрики сервисов, Kafka, Connect, Flink")
        Container(grafana, "Grafana", "Dashboards", "SLO, Kafka health, Saga, stream jobs")
        Container(alertmanager, "Alertmanager", "Alert routing", "Эскалации SRE")
        Container(logs_traces, "Loki + Tempo/Jaeger + OpenTelemetry", "Logs and traces", "Корреляция по correlation_id")
    }


Rel(domain_services, service_dbs, "state + outbox")
Rel(service_dbs, outbox_relay, "CDC")
Rel(outbox_relay, kafka_platform, "events")

Rel(kafka_platform, event_consumers, "events / commands")
Rel(kafka_platform, monitoring, "metrics, lag, DLQ")
Rel(event_consumers, monitoring, "Saga and stream metrics")

Lay_D(domain_services, service_dbs)
Lay_D(service_dbs, outbox_relay)
Lay_D(outbox_relay, kafka_platform)
Lay_D(kafka_platform, event_consumers)
Lay_D(event_consumers, monitoring)

SHOW_LEGEND()
@enduml
